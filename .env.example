# Local examples only. Configure production values on the Node.js host.
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.6-luna
# Jev高速分類（Vercel AI Gateway）。JEV_API_KEYを優先し、未設定時はAI_GATEWAY_API_KEYを使用。
JEV_API_KEY=
AI_GATEWAY_API_KEY=
# /developer/jev を表示できるGoogle・Xログインのメール。カンマ区切り。
DEVELOPER_EMAILS=
REVIEW_DAILY_LIMIT=200
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAY_ENABLED=false
RIOT_PRODUCT_APPROVED=false
# Riot Sign On: 公開後にProduction KeyとRSOが承認されてから設定
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_AUTHORIZE_URL=
RIOT_RSO_TOKEN_URL=
RIOT_RSO_USERINFO_URL=
RIOT_RSO_SCOPES=openid
MERCHANT_NAME=
MERCHANT_REPRESENTATIVE=
MERCHANT_ADDRESS=
MERCHANT_PHONE=
SUPPORT_EMAIL=

# Supabase Auth: Google and X (OAuth 2.0)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_AUTH_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AUTH_SITE_URL=https://radiantai.jp
NEXT_PUBLIC_SITE_URL=https://radiantai.jp

# Persistent local disk; empty uses .data/radiant.sqlite
SQLITE_PATH=

# Supabase Postgres pooler URL. Keep server-only and use SSL.
SUPABASE_DATABASE_URL=
TRAINING_VIDEOS_DATABASE_URL=

# Railway video-analysis service. Keep the shared token server-only.
VIDEO_ANALYSIS_BACKEND_URL=
VIDEO_ANALYSIS_BACKEND_TOKEN=

# Railway only: AIM death-clip micro analysis
GEMINI_API_KEY=
GEMINI_AIM_MODEL=gemini-3.8-flash
