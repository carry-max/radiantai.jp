# Local examples only. Configure production values on the Node.js host.
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.6-luna
REVIEW_DAILY_LIMIT=200
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAY_ENABLED=false
RIOT_PRODUCT_APPROVED=false
MERCHANT_NAME=
MERCHANT_REPRESENTATIVE=
MERCHANT_ADDRESS=
MERCHANT_PHONE=
SUPPORT_EMAIL=

# Supabase Auth: Google and X (OAuth 2.0)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTH_SITE_URL=https://radiantai.jp
NEXT_PUBLIC_SITE_URL=https://radiantai.jp

# Persistent local disk; empty uses .data/radiant.sqlite
SQLITE_PATH=

# Railway PostgreSQL. On Vercel, set DATABASE_URL to Railway's DATABASE_PUBLIC_URL.
# Append ?sslmode=require when Railway's generated URL does not already specify SSL.
DATABASE_URL=
RAILWAY_DATABASE_PUBLIC_URL=
